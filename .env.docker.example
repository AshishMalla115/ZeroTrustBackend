# .env.docker
# Owner: Indra (Layer 4 — Database)
# Used by: docker-compose.yml (NOT for local development — use .env for that)
#
# DB_HOST = "postgres"  (the Docker service name, not localhost)
# REDIS_HOST = "redis"  (the Docker service name, not localhost)
#
# These values match the service names in docker-compose.yml exactly.

DB_HOST=postgres
DB_PORT=5432
DB_NAME=zero_trust_db
DB_USER=ztrust_app
DB_PASSWORD=CHANGE_ME
REDIS_HOST=redis
REDIS_PORT=6379
HMAC_SECRET_KEY=CHANGE_ME


