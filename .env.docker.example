JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
SO_PATH=/app/libriskscore.so
MODEL_PATH=/app/model.isof

POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
READONLY_DB_PASSWORD=CHANGE_ME